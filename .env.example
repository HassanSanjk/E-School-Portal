# Copy this file to .env (which is gitignored) and fill in real values from
# the Supabase project dashboard: Project Settings -> API Keys -> use the
# "Publishable key" (sb_publishable_...), not the legacy anon key -
# Supabase is retiring the legacy anon/service_role key format end of 2026.
# Never commit .env itself - see AGENTS.md.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
