# Copy this file to .env (never commit .env itself) and fill in real values
# from the Supabase project dashboard: Project Settings → API.

# Project URL, e.g. https://etknmekjunxbdjwpqbwa.supabase.co
VITE_SUPABASE_URL=

# The publishable ("anon") key — safe to expose client-side; RLS is what
# actually protects the data, not secrecy of this key. Never put the
# service_role key here or anywhere in frontend code.
VITE_SUPABASE_PUBLISHABLE_KEY=
